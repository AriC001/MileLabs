---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Button from '../components/Button.astro';
import ProductCart from '../components/ProductCart.astro';
import products from '../components/products.json';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div id="webcrumbs">
  <div class="w-[1200px] mx-auto p-6 bg-gray-50 min-h-screen">
    <div class="mb-8 ">
      <h1 class="text-4xl font-bold text-center mb-2 text-primary-600">Product Catalog</h1>
      <p class="text-center text-gray-600">Discover our amazing collection of products</p>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
        
        
        <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-200" data-handler="handler_0">
          <option value="all">All Prices</option>
          <option value="0-50">$0 - $50</option>
          <option value="50-100">$50 - $100</option>
          <option value="100-200">$100 - $200</option>
          <option value="200+">$200+</option>
        </select>
        <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-200" data-handler="handler_1">
          <option value="default">Sort by</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
        </select>
      </div>
    </div>

    <div class="products-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
		{products.map(({name,description,price,img})=> (
		<div data-price={price}>
			<ProductCart name={name} description={description} price={price} img={img} />
		</div>
		))}
	</div>

	
    
  </div>
</div>

		<script is:inline>
			document.querySelector('[data-handler="handler_0"]').addEventListener('change', (e) => {
				const range = e.target.value;
				const container = document.querySelector('.products-grid');

				Array.from(container.children).forEach((productEl) => {
				const price = parseFloat(productEl.getAttribute('data-price'));
				let show = true;
				if (range === '0-50' && (price < 0 || price > 50)) show = false;
				if (range === '50-100' && (price <= 50 || price > 100)) show = false;
				if (range === '100-200' && (price <= 100 || price > 200)) show = false;
				if (range === '200+' && price <= 200) show = false;
				if (range === 'all') show = true;
				productEl.style.display = show ? 'block' : 'none';
				});
			});

			document.querySelector('[data-handler="handler_1"]').addEventListener('change', (e) => {
				const sortBy = e.target.value;
				const container = document.querySelector('.products-grid');
				const productsArr = Array.from(container.children);

				productsArr.sort((a, b) => {
				const priceA = parseFloat(a.getAttribute('data-price'));
				const priceB = parseFloat(b.getAttribute('data-price'));
				if (sortBy === 'price-asc') return priceA - priceB;
				if (sortBy === 'price-desc') return priceB - priceA;
				return 0;
				});

				productsArr.forEach(product => container.appendChild(product));
			});
			</script>
		</main>
		<Footer />
	</body>
</html>
