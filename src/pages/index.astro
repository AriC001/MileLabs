---
import "../styles/global.css";
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import products from "../components/products.json";
const testProducts = products.map((p) => ({
    ...p,
    price: Number(p.price || 0),
}));

import ProductCart from '../components/ProductCart.astro';
// import products from '../components/products.json';
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Tests - Products</title>
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <style>
            body {
                font-family: system-ui, sans-serif;
                background: #f7fafc;
                color: #111827;
            }
            .container {
                max-width: 62.5rem;
                margin: 0 auto;
            }
            /* Controls card style on larger screens */
            @media (min-width:1100px) {
                .controls {
                    background: #f6f8fd;
                    padding: 1rem;
                    border-radius: 0.5rem;
                    box-shadow: 0 0.0625rem 0.1875rem rgba(0, 0, 0, 0.08);
                }
            }

            /* Layout: column on mobile, row on wide screens */
            .layout {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                align-items: stretch;
            }
            @media (min-width:1100px) {
                .layout{
                    flex-direction: row;
                    align-items: flex-start;
                }
            }

            /* Sticky filters on wide screens */
            .sticky-left {
                width: auto;
            }
            @media (min-width:1100px) {
                .sticky-left {
                    position: sticky;
                    top: 1rem;
                    align-self: start;
                    width: 13.75rem;
                }
            }

            /* Products grid: responsive columns using auto-fit/minmax to avoid cards shrinking
               Set a sensible max-width so the grid centers and items don't overflow the page */
            .products-grid {
                display: grid;
                gap: 0.75rem;
                margin-top: 0.75rem;
                width: 100%;
                max-width: 1200px; /* limit total grid width on very wide screens */
                margin-left: auto;
                margin-right: auto;
                box-sizing: border-box;
                justify-items: stretch;
                align-items: stretch;
                justify-content: center;
            }

            /* small screens: 1 column (default), sm -> 2 */
            @media (min-width:640px) {
                .products-grid { grid-template-columns: repeat(2, 1fr); }
            }

            /* md and up: use auto-fit with a sensible minimum card width to avoid tiny cards */
            @media (min-width:768px) {
                .products-grid { grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); }
                #product-card {min-height:23rem}
            }

            /* md and up: use auto-fit with a sensible minimum card width to avoid tiny cards */
            @media (min-width:1100px) {
                .products-grid { grid-template-columns: repeat(auto-fit, minmax(18.5rem, 1fr)); }
                #product-card {min-height:25rem}
            }

            /* xl: allow slightly larger minimums */
            @media (min-width:1280px) {
                .products-grid { grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); }
                #product-card {min-height:28rem}
            }

            /* ensure children can shrink properly inside grid cells */
            .products-grid > * { 
                min-width: 0;           /* NEW */
                align-items: stretch;   /* NEW */
            }

            .card {
                background: #fff;
                padding: 0.75rem;
                border-radius: 0.375rem;
                border: 1px solid #e5e7eb;
                display: flex;          
                flex-direction: column; /* NEW */
                height: 100%;           /* NEW: fill the grid cell */
            }
            .results {
                margin-top: 1.125rem;
                padding: 0.75rem;
                border-radius: 0.375rem;
                background: #fff;
            }
            /* If your ProductCart has image + content + footer sections, ensure main content grows */
            .card > .card-body,
            .card > .content,
            .card .body {              /* try common class names used inside the card */
                flex: 1 1 auto;        /* NEW: let content expand */
            }

            /* constrain images so they don't change card height unexpectedly */
            .card img {
                width: 100%;
                height: auto;
                max-height: 12rem;     /* adjust to taste */
                object-fit: cover;
            }

            .pass { color: green; }
            .fail { color: red; }
        </style>
    <Header />
    </head>
    <body>
        <div class="w-auto mx-auto p-6 bg-gray-50 min-h-screen">
            <div class="mb-8">
                <h1
                    class="text-4xl font-bold text-center mb-2 text-primary-600"
                >
                    Catalogo de Productos
                </h1>
                <p class="text-center text-gray-600">
                    Descubrí nuestra increible collecion de procutos
                </p>
            </div>
            <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                <div class="grid grid-cols-1 gap-4 mb-4">
                    <!-- <div class="container"> -->
                        <!-- <h1>Products - Test Runner</h1> -->
                        <div class="layout">
                            <!-- <div class="controls sticky-left" id="filters-area">
                                <h3>Filtros</h3>
                                <div>
                                    <label>Categoria</label>
                                    <ul id="menu-main-menu" class="menu flex gap-5 flex-wrap sm:flex-nowrap list-item p-2 m-0" >
                                         <li role="none">
                                            <a
                                                class="ct-menu-link text-gray-800 hover:underline font-bold text-base sm:text-lg"
                                                href=""
                                                id="all">Todos</a>
                                        </li>
                                        <li role="none">
                                            <a
                                                class="ct-menu-link text-gray-800 hover:underline font-bold text-base sm:text-lg"
                                                href=""
                                                id="Plata">Plata</a>
                                        </li>
                                        <li role="none">
                                            <a
                                                class="ct-menu-link text-gray-800 hover:underline font-bold text-base sm:text-lg"
                                                href=""
                                                id="Acero">Acero</a>
                                        </li>
                                    </ul>
                                </div> -->
						
                            </div>

                            <div style="flex:1">
                                <div id="products-grid" class="products-grid max-w-5xl mx-auto">
                                    {testProducts.slice().reverse().map(({name,description,price,img}) => (
                                        <div data-price={price}>
                                            <ProductCart name={name} description={description} img={img} />
                                        </div>
                                    ))}
                                </div>

                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <Footer/>
        <script>
            /** @type {any} */
            const w = /** @type {any} */ (window);
            // ensure property exists for TS checks
            w.resetFilters = w.resetFilters || undefined;
            // Safe DOM helpers with guards to avoid compile/TS errors in Astro
            const container = document.getElementById("products-grid");

            // Arrow function genérica para filtrar por cualquier data-attribute
            /** @type {(attrKey: string, value: any) => void} */
            function filterBy(attrKey, value) {
                const v = String(value || "").toLowerCase();
                if (!container) return;
                Array.from(container.children).forEach((card) => {
                    if (!(card instanceof HTMLElement)) return;
                    const cardVal = String(card.getAttribute(`data-${attrKey}`) || "").toLowerCase();
                    const show = v === "all" || v === "" ? true : cardVal === v;
                    // empty string restores default display
                    card.style.display = show ? "" : "none";
                });
            }

            // Conectar select (filtrado) — guardamos la referencia y comprobamos el tipo
            const filterSelectEl = document.getElementById("filter-select");
            if (filterSelectEl instanceof HTMLSelectElement) {
                filterSelectEl.addEventListener("change", (e) => {
                    const val = e.target && e.target instanceof HTMLSelectElement ? e.target.value : "";
                    filterBy("category", val);
                });
            }

            // Conectar los <a> del menu para que también filtren al click
            document.querySelectorAll("#menu-main-menu a[id]").forEach((a) => {
                a.addEventListener("click", (e) => {
                    e.preventDefault();
                    const value = a.id || a.textContent.trim();
                    // normalizar valores si hace falta (ej: "Plata" exacto)
                    filterBy("category", value);
                    if (filterSelectEl instanceof HTMLSelectElement) {
                        filterSelectEl.value = ["Plata", "Acero"].includes(value) ? value : "all";
                    }
                });
            });

            // Helper público para resetear filtros
            w.resetFilters = () => {
                if (filterSelectEl instanceof HTMLSelectElement) filterSelectEl.value = "all";
                filterBy("category", "all");
            };

            // Reuse handlers from original page (filter + sort) - left commented for now
            (function setupHandlers() {
                const filterEl = document.querySelector('[data-handler="handler_0"]');
                const sortEl = document.querySelector('[data-handler="handler_1"]');
                const containerEl = document.querySelector(".products-grid");

                // legacy handlers intentionally left commented
            })();
        </script>
    </body>
</html>
